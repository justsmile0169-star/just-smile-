rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user document exists
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Get user document data safely
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Get user role safely
    function userRole() {
      return userExists() ? userDoc().role : null;
    }

    // Check if user is admin
    function isAdmin() {
      return isAuthenticated() && userExists() && userRole() == 'admin';
    }

    // Check if user is staff
    function isStaff() {
      return isAuthenticated() && userExists() && userRole() in ['admin', 'manager', 'cashier', 'accountant'];
    }

    function isManagerOrAdmin() {
      return isAdmin() || (isAuthenticated() && userExists() && userRole() == 'manager');
    }

    // User Profiles
    match /users/{userId} {
      // Allow get for own profile only or staff (strictly forbidden for unauthenticated visitors or other users)
      allow get: if isStaff() || (isAuthenticated() && request.auth.uid == userId);
      // Allow list queries for staff only (strictly forbidden for public visitors and doctors)
      allow list: if isStaff();

      // Allow self-registration for doctors only (status active or pending, role MUST be doctor)
      // Normal users CANNOT create admin or staff accounts!
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                      request.resource.data.role == 'doctor' &&
                      request.resource.data.status in ['pending', 'active'];

      // Only Admin can create staff accounts (admin, manager, cashier, accountant)
      allow create: if isAdmin() &&
                      request.resource.data.role in ['admin', 'manager', 'cashier', 'accountant'];

      // Allow update:
      // 1. Admin can update any profile (including role, credit status, grace days, etc.)
      // 2. Manager can update doctor profiles
      // 3. Doctor completing profile initial setup after first Google Sign-in
      // 4. Authenticated Doctor updating their own password or last login ONLY (cannot touch role, name, phone, clinic, location, credit permissions!)
      // 5. Staff updating their own password or last login
      allow update: if isAdmin() ||
                      (isManagerOrAdmin() && resource.data.role == 'doctor') ||
                      (isAuthenticated() && request.auth.uid == userId && resource.data.role == 'doctor' &&
                       resource.data.isProfileComplete == false &&
                       request.resource.data.role == 'doctor' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'clinicName', 'location', 'wilayaCode', 'wilayaName', 'communeName', 'communeNameAscii', 'isProfileComplete', 'lastLoginAt'])) ||
                      (isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'lastLoginAt']));

      // Allow delete for admins only
      allow delete: if isAdmin();

      // ── Bootstrap: allow setting password for accounts that have none yet ──
      allow update: if !('password' in resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password']) &&
                      request.resource.data.password is string &&
                      request.resource.data.password.size() > 20;
    }
    
    // Products
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isManagerOrAdmin();
      // Only manager/admin can update product prices/details.
      // Customer orders can ONLY decrement/increment stock, salesCount, and variants.
      allow update: if isManagerOrAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'salesCount', 'variants'])
      );
    }
    
    // Orders
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      // Staff can update orders. Doctors can only cancel their own order (cannot modify financial totals)
      allow update: if isAdmin() || userRole() == 'accountant' || userRole() == 'cashier' || userRole() == 'manager' || (
        isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.paidAmount == resource.data.paidAmount
      );
      allow delete: if isAdmin();
    }
    
    // Payments
    match /payments/{paymentId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isStaff();
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // Favorites
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // Product Returns
    match /returns/{returnId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isStaff();
    }
    
    // Promotions
    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isManagerOrAdmin();
    }
    
    // Expenses
    match /expenses/{expenseId} {
      allow read: if isStaff();
      allow write: if isManagerOrAdmin() || userRole() == 'accountant';
    }

    // Suppliers (Fournisseurs)
    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Purchases / Purchase Invoices (Achats)
    match /purchases/{purchaseId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Supplier Payments (Paiements Fournisseurs)
    match /supplier_payments/{paymentId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    
    // Activity Logs
    match /activity_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() || isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Shop Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isManagerOrAdmin() || (settingId == 'backup_meta' && isStaff());
    }

    // Admin Messages (doctor to admin communication)
    match /admin_messages/{messageId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && userExists() && userRole() == 'doctor';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Announcements / Ads (visible to all, writable by manager+)
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isManagerOrAdmin() || (isAuthenticated() && userExists() && userRole() == 'cashier');
    }

    // Profile Update Requests (from doctors to admin)
    match /profile_update_requests/{requestId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.doctorId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.doctorId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isStaff();
      allow delete: if isStaff() || (isAuthenticated() && resource.data.doctorId == request.auth.uid && resource.data.status == 'pending');
    }
  }
}
