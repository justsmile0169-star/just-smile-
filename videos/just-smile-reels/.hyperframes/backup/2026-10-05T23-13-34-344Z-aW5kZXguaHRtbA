<!DOCTYPE html>
<html lang="fr" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>Just Smile - Reels Promo Video</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800;900&family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- GSAP for seek-safe animation -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background-color: #030a14;
        font-family: 'Outfit', 'Cairo', sans-serif;
        color: #ffffff;
        -webkit-font-smoothing: antialiased;
      }

      /* Root Canvas */
      #root {
        position: relative;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: radial-gradient(circle at 50% 25%, #0d2a4a 0%, #051324 55%, #020710 100%);
      }

      /* Ambient Glow Background Layers */
      .ambient-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        z-index: 1;
      }
      .orb-1 {
        width: 600px;
        height: 600px;
        top: 100px;
        left: 240px;
        background: radial-gradient(circle, rgba(6, 182, 212, 0.22) 0%, rgba(6, 182, 212, 0) 70%);
      }
      .orb-2 {
        width: 700px;
        height: 700px;
        bottom: 150px;
        right: -100px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.18) 0%, rgba(59, 130, 246, 0) 70%);
      }

      /* Tech Background Grid */
      .tech-grid {
        position: absolute;
        inset: 0;
        background-image: 
          linear-gradient(to right, rgba(6, 182, 212, 0.05) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(6, 182, 212, 0.05) 1px, transparent 1px);
        background-size: 60px 60px;
        mask-image: radial-gradient(ellipse 90% 70% at 50% 45%, black 40%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 45%, black 40%, transparent 80%);
        z-index: 2;
        pointer-events: none;
      }

      /* Common Clip Styling */
      .clip {
        position: absolute;
        inset: 0;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 60px;
      }

      /* Top Header Persistent Bar */
      .top-brand-bar {
        position: absolute;
        top: 70px;
        left: 60px;
        right: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 50;
      }
      .top-logo-group {
        display: flex;
        align-items: center;
        gap: 18px;
      }
      .mini-logo-badge {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.25), rgba(30, 58, 138, 0.45));
        border: 1.5px solid rgba(6, 182, 212, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.35);
      }
      .mini-logo-badge img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.6));
      }
      .brand-title-wrap {
        display: flex;
        flex-direction: column;
      }
      .brand-title-wrap .title-txt {
        font-size: 26px;
        font-weight: 900;
        letter-spacing: 0.08em;
        color: #ffffff;
      }
      .brand-title-wrap .sub-txt {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: #06b6d4;
        text-transform: uppercase;
      }
      .live-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        border-radius: 9999px;
        background: rgba(6, 182, 212, 0.12);
        border: 1px solid rgba(6, 182, 212, 0.35);
        font-size: 14px;
        font-weight: 700;
        color: #67e8f9;
        letter-spacing: 0.05em;
      }
      .pulse-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #06b6d4;
        box-shadow: 0 0 10px #06b6d4;
      }

      /* Bottom Subtitle / Captions Bar */
      .captions-container {
        position: absolute;
        bottom: 110px;
        left: 50px;
        right: 50px;
        z-index: 60;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .caption-bubble {
        background: rgba(4, 15, 30, 0.9);
        border: 1.5px solid rgba(6, 182, 212, 0.5);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7), 0 0 35px rgba(6, 182, 212, 0.25);
        border-radius: 24px;
        padding: 22px 36px;
        max-width: 960px;
        backdrop-filter: blur(16px);
      }
      .caption-ar {
        font-family: 'Cairo', sans-serif;
        font-size: 34px;
        font-weight: 800;
        line-height: 1.35;
        direction: rtl;
        color: #f1f5f9;
        margin-bottom: 8px;
      }
      .caption-ar .highlight {
        color: #38bdf8;
        text-shadow: 0 0 12px rgba(56, 189, 248, 0.7);
      }
      .caption-fr {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 21px;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: #94a3b8;
        text-transform: uppercase;
      }

      /* Glass Card Utility */
      .glass-card {
        background: rgba(10, 31, 56, 0.65);
        border: 1.5px solid rgba(6, 182, 212, 0.3);
        border-radius: 28px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
      }

      /* ---------------------------------------------------- */
      /* SCENE 1 : Problem Hook (0s - 10s)                    */
      /* ---------------------------------------------------- */
      #scene-1 .inner-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 940px;
      }
      .warning-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 12px 28px;
        border-radius: 9999px;
        background: rgba(239, 68, 68, 0.15);
        border: 1.5px solid rgba(239, 68, 68, 0.45);
        color: #fca5a5;
        font-size: 20px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 30px;
      }
      .scene-title-large {
        font-size: 64px;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin-bottom: 24px;
        direction: rtl;
      }
      .scene-title-large span.glow-red {
        color: #f87171;
        text-shadow: 0 0 25px rgba(239, 68, 68, 0.5);
      }
      .scene-title-large span.glow-cyan {
        color: #38bdf8;
        text-shadow: 0 0 25px rgba(56, 189, 248, 0.5);
      }

      .problem-cards-wrap {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 100%;
        margin-top: 40px;
      }
      .problem-item {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 24px 32px;
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(239, 68, 68, 0.25);
        border-radius: 20px;
        direction: rtl;
      }
      .problem-icon-box {
        width: 72px;
        height: 72px;
        border-radius: 18px;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
      }
      .problem-text-box {
        text-align: right;
        direction: rtl;
        flex: 1;
      }
      .problem-text-box h3 {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 6px;
      }
      .problem-text-box p {
        font-size: 20px;
        color: #94a3b8;
      }

      /* ---------------------------------------------------- */
      /* SCENE 2 : Solution Reveal - Just Smile (10s - 20s)   */
      /* ---------------------------------------------------- */
      #scene-2 .inner-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 960px;
      }
      .big-logo-container {
        position: relative;
        width: 320px;
        height: 240px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .big-logo-glow-ring {
        position: absolute;
        inset: -25px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(6, 182, 212, 0.45) 0%, rgba(6, 182, 212, 0) 70%);
        filter: blur(35px);
      }
      .white-logo-hero {
        position: relative;
        width: 290px;
        height: 195px;
        object-fit: contain;
        filter: drop-shadow(0 0 25px rgba(6, 182, 212, 0.7)) drop-shadow(0 0 10px rgba(255, 255, 255, 0.6));
      }
      .brand-hero-title {
        font-size: 78px;
        font-weight: 900;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin-bottom: 8px;
        text-shadow: 0 0 40px rgba(6, 182, 212, 0.6);
      }
      .brand-hero-sub {
        font-size: 28px;
        font-weight: 700;
        color: #38bdf8;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 35px;
      }
      .solution-pill-tag {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        padding: 16px 36px;
        border-radius: 9999px;
        background: rgba(6, 182, 212, 0.15);
        border: 1.5px solid rgba(6, 182, 212, 0.45);
        font-size: 24px;
        font-weight: 800;
        color: #67e8f9;
        box-shadow: 0 0 30px rgba(6, 182, 212, 0.25);
      }

      /* ---------------------------------------------------- */
      /* SCENE 3 : The 6 Real Categories (20s - 33s)          */
      /* ---------------------------------------------------- */
      #scene-3 .inner-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 980px;
      }
      .categories-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
        width: 100%;
        margin-top: 35px;
      }
      .category-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 24px 26px;
        background: rgba(10, 31, 56, 0.7);
        border: 1.5px solid rgba(6, 182, 212, 0.25);
        border-radius: 22px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
      }
      .cat-icon-wrap {
        width: 68px;
        height: 68px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(30, 58, 138, 0.4));
        border: 1px solid rgba(6, 182, 212, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        flex-shrink: 0;
      }
      .cat-info {
        display: flex;
        flex-direction: column;
      }
      .cat-title-fr {
        font-size: 24px;
        font-weight: 800;
        color: #ffffff;
      }
      .cat-title-ar {
        font-family: 'Cairo', sans-serif;
        font-size: 19px;
        font-weight: 700;
        color: #38bdf8;
      }
      .pricing-banner {
        margin-top: 36px;
        width: 100%;
        padding: 20px 32px;
        border-radius: 20px;
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.15), rgba(6, 182, 212, 0.2));
        border: 1.5px solid rgba(16, 185, 129, 0.4);
        display: flex;
        align-items: center;
        justify-content: space-around;
      }
      .pricing-item {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 22px;
        font-weight: 800;
        color: #6ee7b7;
      }

      /* ---------------------------------------------------- */
      /* SCENE 4 : 69 Wilayas Delivery (33s - 45s)            */
      /* ---------------------------------------------------- */
      #scene-4 .inner-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 960px;
      }
      .wilaya-counter-box {
        position: relative;
        padding: 30px 60px;
        border-radius: 36px;
        background: radial-gradient(circle at 50% 50%, #0d3862, #051a33);
        border: 2px solid rgba(6, 182, 212, 0.5);
        box-shadow: 0 0 60px rgba(6, 182, 212, 0.35);
        margin: 30px 0 25px 0;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .wilaya-number {
        font-size: 140px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.04em;
        color: #ffffff;
        text-shadow: 0 0 50px rgba(6, 182, 212, 0.8), 0 0 20px rgba(56, 189, 248, 0.8);
      }
      .wilaya-label {
        font-size: 32px;
        font-weight: 900;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #38bdf8;
        margin-top: 10px;
      }
      .delivery-features-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        width: 100%;
        margin-top: 25px;
      }
      .delivery-feature-item {
        padding: 24px;
        border-radius: 20px;
        background: rgba(10, 31, 56, 0.6);
        border: 1px solid rgba(6, 182, 212, 0.25);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 10px;
      }
      .delivery-feature-icon {
        font-size: 40px;
      }
      .delivery-feature-title {
        font-size: 22px;
        font-weight: 800;
        color: #ffffff;
      }
      .delivery-feature-sub {
        font-size: 17px;
        color: #94a3b8;
      }

      /* ---------------------------------------------------- */
      /* SCENE 5 : Web Platform & Orders (45s - 55s)          */
      /* ---------------------------------------------------- */
      #scene-5 .inner-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 960px;
      }
      .mockup-window {
        width: 100%;
        border-radius: 28px;
        background: #07192f;
        border: 1.5px solid rgba(6, 182, 212, 0.35);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6), 0 0 40px rgba(6, 182, 212, 0.2);
        overflow: hidden;
        margin-top: 35px;
      }
      .mockup-header-bar {
        height: 54px;
        background: #0a223f;
        display: flex;
        align-items: center;
        padding: 0 24px;
        gap: 12px;
        border-bottom: 1px solid rgba(6, 182, 212, 0.2);
      }
      .mockup-dots {
        display: flex;
        gap: 8px;
      }
      .dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
      }
      .dot-red { background: #ef4444; }
      .dot-yellow { background: #eab308; }
      .dot-green { background: #22c55e; }
      .mockup-url-bar {
        flex: 1;
        height: 32px;
        background: rgba(4, 15, 30, 0.7);
        border-radius: 8px;
        display: flex;
        align-items: center;
        padding: 0 16px;
        font-size: 15px;
        color: #67e8f9;
        font-family: monospace;
      }
      .mockup-body {
        padding: 36px 32px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .step-row {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 18px 24px;
        background: rgba(10, 31, 56, 0.8);
        border-radius: 16px;
        border: 1px solid rgba(6, 182, 212, 0.2);
        direction: rtl;
      }
      .step-num {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #06b6d4;
        color: #030a14;
        font-size: 22px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .step-txt {
        text-align: right;
        flex: 1;
      }
      .step-txt h4 {
        font-size: 22px;
        font-weight: 800;
        color: #ffffff;
      }
      .step-txt p {
        font-size: 17px;
        color: #94a3b8;
      }

      /* ---------------------------------------------------- */
      /* SCENE 6 : Call To Action & Contacts (55s - 65s)      */
      /* ---------------------------------------------------- */
      #scene-6 .inner-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 960px;
      }
      .cta-button-large {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        width: 100%;
        max-width: 820px;
        padding: 24px 36px;
        border-radius: 24px;
        background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
        box-shadow: 0 16px 45px rgba(6, 182, 212, 0.45), 0 0 35px rgba(6, 182, 212, 0.3);
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: #020b17;
        font-size: 32px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 25px 0 20px 0;
      }

      /* Contact & Socials Cards in Scene 6 */
      .contacts-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        width: 100%;
        max-width: 860px;
        margin-top: 10px;
      }
      .contact-card-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        background: rgba(10, 31, 56, 0.85);
        border: 1.5px solid rgba(6, 182, 212, 0.35);
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
      }
      .contact-icon-bubble {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
      }
      .icon-phone {
        background: rgba(34, 197, 94, 0.2);
        border: 1px solid rgba(34, 197, 94, 0.4);
        color: #4ade80;
      }
      .icon-ig {
        background: rgba(225, 48, 108, 0.2);
        border: 1px solid rgba(225, 48, 108, 0.4);
        color: #f472b6;
      }
      .icon-fb {
        background: rgba(24, 119, 242, 0.2);
        border: 1px solid rgba(24, 119, 242, 0.4);
        color: #60a5fa;
      }
      .icon-web {
        background: rgba(6, 182, 212, 0.2);
        border: 1px solid rgba(6, 182, 212, 0.4);
        color: #67e8f9;
      }
      .contact-details {
        display: flex;
        flex-direction: column;
        text-align: left;
      }
      .contact-details .label {
        font-size: 13px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .contact-details .val {
        font-size: 19px;
        font-weight: 800;
        color: #ffffff;
      }

      .slogan-final {
        font-family: 'Cairo', sans-serif;
        font-size: 34px;
        font-weight: 900;
        color: #ffffff;
        margin-top: 25px;
        text-shadow: 0 0 25px rgba(6, 182, 212, 0.6);
        direction: rtl;
      }
    </style>
  </head>
  <body>
    <div
      id="root"
      data-composition-id="main"
      data-start="0"
      data-duration="65"
      data-width="1080"
      data-height="1920"
    >
      <!-- Background Ambient Elements -->
      <div class="ambient-orb orb-1"></div>
      <div class="ambient-orb orb-2"></div>
      <div class="tech-grid"></div>

      <!-- ==================================================== -->
      <!-- AUDIO SOUNDTRACK & VOICE-OVERS                       -->
      <!-- ==================================================== -->
      <!-- Background Music Bed -->
      <audio
        id="bgm"
        src="./assets/bgm.wav"
        data-start="0"
        data-duration="65"
        data-volume="0.28"></audio>

      <!-- Algerian Arabic Neural Voiceovers per Scene -->
      <audio id="vo-1" src="./assets/vo_scene1.mp3" data-start="0.8" data-duration="8.5" data-volume="1" data-hidden=""></audio>
      <audio id="vo-2" src="./assets/vo_scene2.mp3" data-start="10.8" data-duration="8.5" data-volume="1"></audio>
      <audio id="vo-3" src="./assets/vo_scene3.mp3" data-start="20.8" data-duration="11.5" data-volume="1"></audio>
      <audio id="vo-4" src="./assets/vo_scene4.mp3" data-start="33.8" data-duration="10.5" data-volume="1"></audio>
      <audio id="vo-5" src="./assets/vo_scene5.mp3" data-start="45.8" data-duration="8.5" data-volume="1"></audio>
      <audio id="vo-6" src="./assets/vo_scene6.mp3" data-start="55.8" data-duration="8.5" data-volume="1"></audio>

      <!-- Transition & Impact SFX -->
      <audio id="sfx-whoosh-1" src="./assets/whoosh.wav" data-start="9.6" data-duration="0.6" data-volume="0.5"></audio>
      <audio id="sfx-whoosh-2" src="./assets/whoosh.wav" data-start="19.6" data-duration="0.6" data-volume="0.5"></audio>
      <audio id="sfx-whoosh-3" src="./assets/whoosh.wav" data-start="32.6" data-duration="0.6" data-volume="0.5"></audio>
      <audio id="sfx-whoosh-4" src="./assets/whoosh.wav" data-start="44.6" data-duration="0.6" data-volume="0.5"></audio>
